PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/chesslens

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3 (server-side, for video recommendations)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: Chess.com & Lichess don't need API keys for public data
# But you can set rate limit settings here
CHESS_COM_BASE_URL=https://api.chess.com/pub
LICHESS_BASE_URL=https://lichess.org/api
